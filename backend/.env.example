# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./timetable.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional AI features (natural-language constraint parsing, infeasibility
# explanations, AI assistant). Works with any OpenAI-compatible chat
# completions endpoint - just point LLM_BASE_URL at your provider and set
# the matching key/model. The rest of the system works normally without
# one; these features degrade gracefully. Examples:
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1        LLM_MODEL=anthropic/claude-opus-4.5
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-5
#   NVIDIA NIM:  LLM_BASE_URL=https://integrate.api.nvidia.com/v1 LLM_MODEL=meta/llama-3.1-70b-instruct
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1           LLM_MODEL=llama3.1  (LLM_API_KEY=ollama)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-opus-4.5

# Solver tuning - see app/core/config.py for what each one does.
SOLVER_MAX_SECONDS=300
SOLVER_NUM_WORKERS=8
SOLVER_DEFAULT_ALTERNATIVES=3

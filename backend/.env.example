# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./timetable.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional AI features (natural-language constraint parsing, infeasibility
# explanations, bulk-import vision extraction). Get a key from
# https://console.anthropic.com/settings/keys - the rest of the system
# works normally without one; these features degrade gracefully.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Solver tuning - see app/core/config.py for what each one does.
SOLVER_MAX_SECONDS=240
SOLVER_NUM_WORKERS=8
SOLVER_DEFAULT_ALTERNATIVES=3

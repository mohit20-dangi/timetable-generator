# Docker Compose Environment Variables
# Copy this to .env and fill in your values
# Never commit .env to version control!

# ============================================
# DATABASE (PostgreSQL - Production Default)
# ============================================

# PostgreSQL password (change for production!)
DB_PASSWORD=timetable123

# DATABASE_URL is constructed from DB_PASSWORD in docker-compose.yml
# For manual override: DATABASE_URL=postgresql://timetable:yourpass@db:5432/timetable

# ============================================
# BACKEND SETTINGS
# ============================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars

# Optional AI features (natural-language constraint parsing, infeasibility explanations, AI assistant)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-opus-4.5

# Solver tuning
SOLVER_MAX_SECONDS=300
SOLVER_NUM_WORKERS=8